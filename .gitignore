# Local parameter overrides (never commit tenant-specific values)
*.local.bicepparam
*.local.json

# Bicep build output
*.json.tmp
main.json

# Azure CLI / deploy scratch
.azure/
*.log

# Test output (Pester / analyzer results)
testResults.xml
*.TestResults.xml
coverage.xml

# Secrets — defense in depth (the repo never stores these by design)
*.pfx
*.pem
.env
.env.*
# Local lab admin-password files (typed once, read by the workloads tooling, never committed)
.secrets/
**/.secrets/
*.secret
.alw_pw
**/admin-password

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
